# 仅开发/测试时覆盖；正式运行默认使用操作系统的应用数据目录。
RISK_AGENT_DATA_DIR=./runtime-v1
RISK_AGENT_HOST=127.0.0.1
RISK_AGENT_PORT=8765
RISK_AGENT_OPEN_BROWSER=1
RISK_AGENT_AUTO_MIGRATE=1
RISK_AGENT_LEGACY_RUNTIME=./runtime
RISK_AGENT_MAX_UPLOAD_MB=2048
RISK_AGENT_MAX_ARCHIVE_MB=8192
RISK_AGENT_WORKER_TIMEOUT_SECONDS=3600

# 可选：优先从环境变量读取密钥。不要把真实值写入仓库。
# RISK_AGENT_API_KEY=
